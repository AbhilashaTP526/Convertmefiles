NEXT_PUBLIC_SITE_URL=

# --- Admin panel (/admin) ---
# Email + password to sign in to /admin. Choose a long, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Settings & analytics storage ---
# Add a free "Upstash Redis" (or "KV") database to this project from the
# Vercel dashboard (Storage -> Create Database) and connect it — Vercel
# will inject KV_REST_API_URL / KV_REST_API_TOKEN automatically, so you
# shouldn't need to set these by hand. Listed here for local development
# against a store you created directly at upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=
